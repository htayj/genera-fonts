  "policy": {
    "artifact_identity": "Resident FONT object names and filenames remain stable physical-strike identities.",
    "primary_identity": "A primary family, face, and logical size is recorded only when resident FONT-SPECS supplies a defensible first mapping.",
    "desktop_identity": "BDF and OTB family, weight, slant, and set width use this reviewed mapping rather than parsing resident-name suffixes.",
    "desktop_disambiguation": "A symbolic-size Strike qualifier is added only where two distinct resident objects would otherwise have the same desktop family, style, and measured pixel size.",
    "specialty_identity": "Specialty character-set fonts use isolated desktop families so they cannot satisfy ordinary body-text family requests.",
    "size_identity": "Logical named size, the device-specific nominal X size, and the measured resident raster line height remain separate.",
    "unmapped_identity": "40VR, EINY8, and VT100 retain separate neutral desktop identities without fabricating a Genera FONT-SPECS tuple."
  },
